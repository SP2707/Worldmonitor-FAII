# Runtime artifacts (generated by sidecar/tools, not source code)
api-cache.json
verbose-mode.json
skills-lock.json
tmp/
# Two tests mkdtemp their stub bins and fixtures INSIDE the repo root
# (seed-freshness-workflow.test.mjs, deploy-gate-status-description.test.mjs),
# so while test:data runs any `git add -A` sweeps them into the commit — which
# is how ten of them reached a branch during #6763, caught only by the pre-push
# worktree-drift gate.
.tmp-seed-freshness-gate-*/
.tmp-deploy-gate-*/
.context/
# Scratch the Umami storage monitor writes on the runner: Railway volume and
# deployment dumps plus its cached growth baseline. Local runs produce them too.
.cache/

# Local planning documents (not for public repo)
docs/plans/
docs/brainstorms/
playground-pricing.html

# Generated at build time by scripts/generate-third-party-notices.mjs (3MB+).
# Ships inside the desktop bundle; never committed. The directory itself IS
# committed (.gitkeep) because tauri-build resolves bundle.resources paths at
# compile time — `cargo test` fails on a resource path that does not exist.
src-tauri/notices/*
!src-tauri/notices/.gitkeep

# scripts/local-redis-rest.mjs's persisted store — the local, Docker-free
# Upstash-REST stand-in that `npm start` auto-launches when no
# UPSTASH_REDIS_REST_URL is configured (scripts/start-with-local-redis.mjs).
# This is a dev-machine data file (can grow to several MB once seeders run
# against it), not source, and its path is also independently overridable
# via LOCAL_REDIS_DATA_FILE.
.local-redis-data.json

# docker/build-handlers.mjs (this fork's npm-start build step, distinct from
# the parent project's scripts/build-sidecar-handlers.mjs /
# scripts/build-sidecar-sebuf.mjs whose output the two api/ rules above
# already cover) compiles EVERY api/**/*.ts to an esbuild bundle at the same
# path with a .js extension. Those bundles were accidentally committed
# alongside their .ts sources in 40a53c2 (~900 files, ~885k lines) — ignore
# every api/**/*.js EXCEPT the hand-written .js files that have no .ts
# counterpart (those ARE the source; docker/build-handlers.mjs's pass 2
# rebundles them in place with inlined deps, so they're allowed to differ
# after a build but stay tracked as source either way).
api/**/*.js
!api/_api-key.js
!api/_bootstrap-public-tier.js
!api/_bootstrap-r2.js
!api/_bootstrap-tier-keys.js
